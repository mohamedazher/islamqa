  "file_structure_notes": {
    "json_format": "Each category file contains an array of duas with comprehensive details",
    "fields_per_dua": [
      "id - Unique identifier within category",
      "category_id - Numeric reference to category",
      "title - English title of the dua",
      "title_ar - Arabic title (often null)",
      "arabic - Original Arabic text",
      "transliteration - Romanized Arabic",
      "translation - English translation",
      "virtue - Hadith narration, commentary, and benefits",
      "reference - Hadith source (Bukhari, Muslim, Tirmidhi, etc.)",
      "repetitions - How many times to recite (if specified)",
      "order - Sequence within category",
      "tags - Topic tags for categorization"
    ],
    "metadata_file": "categories.json contains master list with dua_count, icon, color, type, and description for each"
  },
  "categorization_logic": {
    "primary_division": "Main categories (type: 'main') vs Other categories (type: 'other')",
