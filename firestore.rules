rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUsername(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    function validCounter(value) {
      return value is int && value >= 0 && value <= 9007199254740991;
    }

    function validActivityPoints(kind, points) {
      return (kind == 'question_read' && points == 5)
        || (kind == 'bookmark_created' && points == 10)
        || (kind == 'quiz_streak' && points == 100)
        || (kind == 'welcome_back' && points == 50)
        || (kind == 'dua_read' && points == 5)
        || (kind == 'morning_adhkar' && points == 20)
        || (kind == 'evening_adhkar' && points == 20)
        || (kind == 'adhkar_streak' && points == 30)
        || (kind == 'both_adhkar' && points == 25)
        || (kind == 'achievement' && points in [25, 50, 100, 150, 200, 250, 300, 1000]);
    }

    function validEventId(value) {
      return value is string && value.size() >= 1 && value.size() <= 100
        && value.matches('^[A-Za-z0-9_-]+$');
    }

    function eventPath(uid, eventId) {
      return /databases/$(database)/documents/users/$(uid)/events/$(eventId);
    }

    function freshEventExists(uid, eventId) {
      return validEventId(eventId)
        && !exists(eventPath(uid, eventId))
        && existsAfter(eventPath(uid, eventId))
        && getAfter(eventPath(uid, eventId)).data.userId == uid
        && getAfter(eventPath(uid, eventId)).data.eventId == eventId;
    }

    function eventAfter(uid, eventId) {
      return getAfter(eventPath(uid, eventId)).data;
    }

    function legacyDailyPath(uid, bucket) {
      return /databases/$(database)/documents/leaderboards/daily/$(bucket)/$(uid);
    }

    function validLegacyDailyMigration(uid) {
      let data = request.resource.data;
      let dailyPath = legacyDailyPath(uid, data.dailyBucket);
      return data.kind == 'legacy_daily'
        && data.keys().hasOnly([
          'eventId', 'userId', 'kind', 'points', 'dailyBucket',
          'weeklyBucket', 'createdAt'
        ])
        && exists(dailyPath)
        && get(dailyPath).data.userId == uid
        && !('lastEventId' in get(dailyPath).data)
        && get(dailyPath).data.score is int
        && get(dailyPath).data.score > 0
        && data.points == get(dailyPath).data.score
        && data.eventId == 'legacy_daily_' + data.dailyBucket;
    }

    function validProfileCreate(uid) {
      return request.resource.data.keys().hasOnly([
          'username', 'totalScore', 'quizzesTaken', 'level', 'createdAt', 'lastActive'
        ])
        && validUsername(request.resource.data.username)
        && request.resource.data.totalScore == 0
        && request.resource.data.quizzesTaken == 0
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 999
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActive == request.time;
    }

    function validProfileMaintenance(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['username', 'lastActive', 'level', 'totalScore', 'quizzesTaken'])
        && validUsername(request.resource.data.username)
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 999
        && validCounter(request.resource.data.totalScore)
        && validCounter(request.resource.data.quizzesTaken)
        && (('totalScore' in resource.data)
          ? request.resource.data.totalScore == resource.data.totalScore
          : request.resource.data.totalScore == 0)
        && (('quizzesTaken' in resource.data)
          ? request.resource.data.quizzesTaken == resource.data.quizzesTaken
          : request.resource.data.quizzesTaken == 0)
        && (!changed.hasAny(['lastActive']) || request.resource.data.lastActive == request.time);
    }

    function validProfileScoreUpdate(uid) {
      let data = request.resource.data;
      let eventId = data.lastEventId;
      let event = eventAfter(uid, eventId);
      return freshEventExists(uid, eventId)
        && data.keys().hasOnly([
          'username', 'totalScore', 'quizzesTaken', 'level', 'createdAt',
          'lastActive', 'lastEventId'
        ])
        && validUsername(data.username)
        && data.createdAt == resource.data.createdAt
        && data.level is int && data.level >= 1 && data.level <= 999
        && validCounter(data.totalScore)
        && data.totalScore == resource.data.totalScore + event.points
        && validCounter(data.quizzesTaken)
        && data.quizzesTaken == resource.data.quizzesTaken
          + (event.kind == 'quiz' ? 1 : 0)
        && data.lastActive == request.time;
    }

    match /users/{uid} {
      // All-time leaderboard queries read these intentionally public profiles.
      allow read: if true;
      allow create: if signedInAs(uid) && validProfileCreate(uid);
      allow update: if signedInAs(uid)
        && (validProfileMaintenance(uid) || validProfileScoreUpdate(uid));
      allow delete: if false;

      match /events/{eventId} {
        // A client may check only its own event ID for idempotent retry.
        allow get: if signedInAs(uid);
        allow list: if false;
        allow create: if signedInAs(uid)
          && request.resource.data.userId == uid
          && request.resource.data.eventId == eventId
          && validEventId(eventId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points <= 1000000
          && request.resource.data.dailyBucket is string
          && request.resource.data.dailyBucket.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.weeklyBucket is string
          && request.resource.data.weeklyBucket.matches('^\\d{4}-W\\d{2}$')
          && (
            (request.resource.data.kind == 'quiz'
              && request.resource.data.keys().hasOnly([
                'eventId', 'userId', 'kind', 'points', 'dailyBucket',
                'weeklyBucket', 'createdAt', 'correct', 'total', 'accuracy',
                'timeTaken', 'quizId', 'mode'
              ])
              && request.resource.data.correct is int
              && request.resource.data.total is int
              && request.resource.data.correct >= 0
              && request.resource.data.correct <= request.resource.data.total
              && request.resource.data.points == request.resource.data.correct * 10
              && request.resource.data.total >= 0
              && request.resource.data.total <= 100
              && request.resource.data.accuracy is number
              && request.resource.data.accuracy >= 0
              && request.resource.data.accuracy <= 100
              && request.resource.data.timeTaken is number
              && request.resource.data.timeTaken >= 0
              && request.resource.data.timeTaken <= 86400000
              && request.resource.data.quizId is string
              && request.resource.data.quizId.size() <= 100
              && request.resource.data.mode is string
              && request.resource.data.mode.size() <= 50)
            ||
            (request.resource.data.kind == 'activity'
              && request.resource.data.keys().hasOnly([
                'eventId', 'userId', 'kind', 'points', 'dailyBucket',
                'weeklyBucket', 'createdAt', 'activityType', 'description'
              ])
              && request.resource.data.activityType is string
              && request.resource.data.activityType.size() >= 1
              && request.resource.data.activityType.size() <= 50
              && request.resource.data.activityType.matches('^[A-Za-z0-9_-]+$')
              && validActivityPoints(request.resource.data.activityType, request.resource.data.points)
              && request.resource.data.description is string
              && request.resource.data.description.size() <= 160)
            || validLegacyDailyMigration(uid)
          );
        allow update, delete: if false;
      }
    }

    function validDailyDocument(uid, bucket) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'userId', 'username', 'score', 'activityPoints', 'correct', 'total',
          'quizzesTaken', 'bestScore', 'bestAccuracy', 'timestamp', 'lastEventId'
        ])
        && data.userId == uid
        && validUsername(data.username)
        && validCounter(data.score)
        && validCounter(data.activityPoints)
        && validCounter(data.correct)
        && validCounter(data.total)
        && validCounter(data.quizzesTaken)
        && validCounter(data.bestScore)
        && data.bestAccuracy is number
        && data.bestAccuracy >= 0 && data.bestAccuracy <= 100
        && data.timestamp == request.time;
    }

    function validDailyScoreCreate(uid, bucket) {
      let data = request.resource.data;
      let event = eventAfter(uid, data.lastEventId);
      return freshEventExists(uid, data.lastEventId)
        && event.dailyBucket == bucket
        && validDailyDocument(uid, bucket)
        && data.score == event.points
        && data.activityPoints == (event.kind == 'activity' ? event.points : 0)
        && data.correct == (event.kind == 'quiz' ? event.correct : 0)
        && data.total == (event.kind == 'quiz' ? event.total : 0)
        && data.quizzesTaken == (event.kind == 'quiz' ? 1 : 0)
        && data.bestScore == (event.kind == 'quiz' ? event.points : 0)
        && data.bestAccuracy == (event.kind == 'quiz' ? event.accuracy : 0);
    }

    function validDailyScoreUpdate(uid, bucket) {
      let data = request.resource.data;
      let event = eventAfter(uid, data.lastEventId);
      return freshEventExists(uid, data.lastEventId)
        && event.dailyBucket == bucket
        && validDailyDocument(uid, bucket)
        && data.username == resource.data.username
        && data.score == resource.data.score + event.points
        && data.activityPoints == (('activityPoints' in resource.data) ? resource.data.activityPoints : 0)
          + (event.kind == 'activity' ? event.points : 0)
        && data.correct == (('correct' in resource.data) ? resource.data.correct : 0)
          + (event.kind == 'quiz' ? event.correct : 0)
        && data.total == (('total' in resource.data) ? resource.data.total : 0)
          + (event.kind == 'quiz' ? event.total : 0)
        && data.quizzesTaken == (('quizzesTaken' in resource.data) ? resource.data.quizzesTaken : 0)
          + (event.kind == 'quiz' ? 1 : 0)
        && data.bestScore == (event.kind == 'quiz'
          ? ((('bestScore' in resource.data) ? resource.data.bestScore : 0) > event.points
            ? (('bestScore' in resource.data) ? resource.data.bestScore : 0)
            : event.points)
          : (('bestScore' in resource.data) ? resource.data.bestScore : 0))
        && data.bestAccuracy == (event.kind == 'quiz'
          ? ((('bestAccuracy' in resource.data) ? resource.data.bestAccuracy : 0) > event.accuracy
            ? (('bestAccuracy' in resource.data) ? resource.data.bestAccuracy : 0)
            : event.accuracy)
          : (('bestAccuracy' in resource.data) ? resource.data.bestAccuracy : 0));
    }

    function validDailyLegacyMigrationUpdate(uid, bucket) {
      let data = request.resource.data;
      let event = eventAfter(uid, data.lastEventId);
      return freshEventExists(uid, data.lastEventId)
        && event.kind == 'legacy_daily'
        && event.dailyBucket == bucket
        && !('lastEventId' in resource.data)
        && validDailyDocument(uid, bucket)
        && data.username
          == getAfter(/databases/$(database)/documents/users/$(uid)).data.username
        && data.score == resource.data.score
        && data.activityPoints == (('activityPoints' in resource.data) ? resource.data.activityPoints : 0)
        && data.correct == (('correct' in resource.data) ? resource.data.correct : 0)
        && data.total == (('total' in resource.data) ? resource.data.total : 0)
        && data.quizzesTaken == (('quizzesTaken' in resource.data) ? resource.data.quizzesTaken : 0)
        && data.bestScore == (('bestScore' in resource.data) ? resource.data.bestScore : 0)
        && data.bestAccuracy == (('bestAccuracy' in resource.data) ? resource.data.bestAccuracy : 0);
    }

    function validDailyLegacyMigrationFinalize(uid, bucket) {
      let data = request.resource.data;
      let eventId = data.lastEventId;
      let priorEventPath = eventPath(uid, eventId);
      let event = get(priorEventPath).data;
      return validEventId(eventId)
        && exists(priorEventPath)
        && event.kind == 'legacy_daily'
        && event.userId == uid
        && event.dailyBucket == bucket
        && event.points == resource.data.score
        && !('lastEventId' in resource.data)
        && validDailyDocument(uid, bucket)
        && data.username
          == get(/databases/$(database)/documents/users/$(uid)).data.username
        && data.score == resource.data.score
        && data.activityPoints == (('activityPoints' in resource.data) ? resource.data.activityPoints : 0)
        && data.correct == (('correct' in resource.data) ? resource.data.correct : 0)
        && data.total == (('total' in resource.data) ? resource.data.total : 0)
        && data.quizzesTaken == (('quizzesTaken' in resource.data) ? resource.data.quizzesTaken : 0)
        && data.bestScore == (('bestScore' in resource.data) ? resource.data.bestScore : 0)
        && data.bestAccuracy == (('bestAccuracy' in resource.data) ? resource.data.bestAccuracy : 0);
    }

    function validLeaderboardUsernameUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['username', 'timestamp'])
        && validUsername(request.resource.data.username)
        && request.resource.data.userId == uid
        && request.resource.data.username
          == getAfter(/databases/$(database)/documents/users/$(uid)).data.username
        && (!changed.hasAny(['timestamp']) || request.resource.data.timestamp == request.time);
    }

    match /leaderboards/daily/{bucket}/{uid} {
      allow read: if true;
      allow create: if signedInAs(uid) && validDailyScoreCreate(uid, bucket);
      allow update: if signedInAs(uid)
        && (validDailyScoreUpdate(uid, bucket)
          || validDailyLegacyMigrationUpdate(uid, bucket)
          || validDailyLegacyMigrationFinalize(uid, bucket)
          || validLeaderboardUsernameUpdate(uid));
      allow delete: if false;
    }

    function validWeeklyDocument(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'userId', 'username', 'totalScore', 'activityPoints', 'quizzesTaken',
          'bestScore', 'timestamp', 'lastEventId'
        ])
        && data.userId == uid
        && validUsername(data.username)
        && validCounter(data.totalScore)
        && validCounter(data.activityPoints)
        && validCounter(data.quizzesTaken)
        && validCounter(data.bestScore)
        && data.timestamp == request.time;
    }

    function validWeeklyScoreCreate(uid, bucket) {
      let data = request.resource.data;
      let event = eventAfter(uid, data.lastEventId);
      return freshEventExists(uid, data.lastEventId)
        && event.weeklyBucket == bucket
        && validWeeklyDocument(uid)
        && data.totalScore == event.points
        && data.activityPoints == (event.kind == 'activity' ? event.points : 0)
        && data.quizzesTaken == (event.kind == 'quiz' ? 1 : 0)
        && data.bestScore == (event.kind == 'quiz' ? event.points : 0);
    }

    function validWeeklyScoreUpdate(uid, bucket) {
      let data = request.resource.data;
      let event = eventAfter(uid, data.lastEventId);
      return freshEventExists(uid, data.lastEventId)
        && event.weeklyBucket == bucket
        && validWeeklyDocument(uid)
        && data.username == resource.data.username
        && data.totalScore == resource.data.totalScore + event.points
        && data.activityPoints == (('activityPoints' in resource.data) ? resource.data.activityPoints : 0)
          + (event.kind == 'activity' ? event.points : 0)
        && data.quizzesTaken == (('quizzesTaken' in resource.data) ? resource.data.quizzesTaken : 0)
          + (event.kind == 'quiz' ? 1 : 0)
        && data.bestScore == (event.kind == 'quiz'
          ? ((('bestScore' in resource.data) ? resource.data.bestScore : 0) > event.points
            ? (('bestScore' in resource.data) ? resource.data.bestScore : 0)
            : event.points)
          : (('bestScore' in resource.data) ? resource.data.bestScore : 0));
    }

    match /leaderboards/weekly/{bucket}/{uid} {
      allow read: if true;
      allow create: if signedInAs(uid) && validWeeklyScoreCreate(uid, bucket);
      allow update: if signedInAs(uid)
        && (validWeeklyScoreUpdate(uid, bucket) || validLeaderboardUsernameUpdate(uid));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
