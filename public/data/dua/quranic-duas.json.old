      "order": 28,
      "tags": [
        "Quranic Duas"
      ]
    },
    {
      "id": 29,
      "category_id": 11,
      "title": "Duʿa of Prophet Sulayman ﷺ for Gratitude to Allah & Doing Good Deeds",
      "title_ar": null,
      "arabic": "رَبِّ أَوْزِعْنِيْٓ أَنْ أَشْكُرَ نِعْمَتَكَ الَّتِيْٓ أَنْعَمْتَ عَلَيَّ وَعَلَىٰ وَالِدَيَّ وَأَنْ أَعْمَلَ صَالِحًا تَرْضَاهُ ، وَأَدْخِلْنِيْ بِرَحْمَتِكَ فِيْ عِبَادِكَ الصَّالِحِيْنَ.",
      "transliteration": "Rabbi awziʿnī an ashkura niʿmataka-l-latī anʿamta ʿalayya wa ʿalā wālidayya wa an aʿmala ṣāliḥan tarḍāh, wa adhkilnī bi-raḥmatika fī ʿibādika-ṣ-ṣāliḥīn.",
      "translation": "My Lord, enable me to be grateful for Your favour which You have bestowed upon me and upon my parents, and to do good deeds that please You. And admit me by Your mercy amongst Your righteous servants. (27:19)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 29,
      "tags": [
        "Quranic Duas",
        "Prophet"
      ]
    },
    {
      "id": 30,
      "category_id": 11,
      "title": "Duʿa for Gratitude, Good Deeds & Pious Children",
      "title_ar": null,
      "arabic": "رَبِّ أَ��ْزِعْنِيْٓ أَنْ أَشْكُرَ نِعْمَتَكَ الَّتِيْٓ أَنْعَمْتَ عَلَيَّ وَعَلَىٰ وَالِدَيَّ وَأَنْ أَعْمَلَ صَالِحًا تَرْضَاهُ ، وَأَصْلِحْ لِيْ فِيْ ذُرِّيَّتِيْ ، إِنِّيْ تُبْتُ إِلَيْكَ وَإِنِّيْ مِنَ الْمُسْلِمِيْنَ.",
      "transliteration": "Rabbi awziʿnī an ashkura niʿmataka-l-latī anʿamta ʿalayya wa ʿalā wālidayya wa an aʿmala ṣāliḥan tarḍāh, wa aṣliḥ lī fī dhuriyyatī, innī tubtu ilayka wa innī mina-l-muslimīn.",
      "translation": "My Lord, enable me to be grateful for Your favour which You have bestowed upon me and upon my parents, and to do good deeds that please You. Make my offspring righteous; I truly repent to you, and truly I am of those who submit to You. (46:15)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 30,
      "tags": [
        "Quranic Duas"
      ]
    },
    {
      "id": 31,
      "category_id": 11,
      "title": "Duʿa for Seeking Protection from Shaytan",
      "title_ar": null,
      "arabic": "رَبِّ أَعُوْذُ بِكَ مِنْ هَمَزَاتِ الشَّيَاطِيْنِ ، وَأَعُوذُ بِكَ رَبِّ أَنْ يَّحْضُرُوْنِ.",
      "transliteration": "Rabbi aʿūdhu bika min hamazāti-sh-shayāṭīn. Wa aʿūdhu bika Rabbi ay-yaḥḍurūn.",
      "translation": "My Lord, I seek protection with You from the promptings of the devils; and I seek protection in You, my Lord, from their coming near me. (23:97-98)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 31,
      "tags": [
        "Quranic Duas",
        "Protection"
      ]
    },
    {
      "id": 32,
      "category_id": 11,
      "title": "Duʿa for Forgiveness & Ease",
      "title_ar": null,
      "arabic": "رَبَّنَا لَا تُؤَاخِذْنَآ إِنْ نَّسِينَآ أَوْ أَخْطَأْنَا ، رَبَّنَا وَلَا تَحْمِلْ عَلَيْنَآ إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِيْنَ مِنْ قَبْلِنَا ، رَبَّنَا وَلَا تُحَمِّلْنَا مَا لَا طَاقَةَ لَنَا بِهِ ، وَاعْفُ عَنَّا وَاغْفِرْ لَنَا وَارْحَمْنَا ، أَنْتَ مَوْلَانَا فَانْصُرْنَا عَلَى الْقَوْمِ الْكٰـفِرِيْنَ.",
      "transliteration": "Rabbanā lā tu’ākidhnā in-nasīnā aw akhṭa’nā, Rabbanā wa lā taḥmil ʿalaynā iṣran kamā ḥamaltahū ʿala-l-ladhīna min qablinā, Rabbanā wa lā tuḥammilnā mā lā ṭāqata lanā bih, waʿfu ʿanna wa-ghfir lanā war-ḥamnā Anta Mawlānā fa-nṣurnā ʿala-l-qawmil-kafirīn.",
      "translation": "Our Lord, do not impose blame upon us if we have forgotten or erred. Our Lord, and do not lay upon us a burden as You laid upon those before us. Our Lord, and do not burden us with that which we have no ability to bear. Pardon us, forgive us and have mercy upon us. You are our Protector, so help us against the disbelieving people. (2:285-6)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 32,
      "tags": [
        "Quranic Duas",
        "Forgiveness"
      ]
    },
    {
      "id": 33,
      "category_id": 11,
      "title": "Duʿa for Forgiveness & Victory",
      "title_ar": null,
      "arabic": "رَبَّنَا اغْفِرْ لَنَا ذُنُوْبَنَا وَإِسْرَافَنَا فِيٓ أَمْرِنَا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكٰـفِرِيْنَ.",
      "transliteration": "Rabbana-ghfir lanā dhunūbanā wa isrāfanā fī amrinā wa thabbit aqdāmanā wa-nṣurnā ʿala-l-qawmil-kafirīn.",
      "translation": "Our Lord, forgive us our sins and our extravagance in our affairs. Make our feet firm, and help us against the disbelieving people. (3:147)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 33,
      "tags": [
        "Quranic Duas",
        "Forgiveness"
      ]
    },
    {
      "id": 34,
      "category_id": 11,
      "title": "Duʿa for For Firmness & Victory",
      "title_ar": null,
      "arabic": "رَبَّنَآ أَفْرِغْ عَلَيْنَا صَبْرًا وَّثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكٰـفِرِيْنَ.",
      "transliteration": "Rabbanā afrigh ʿalaynā ṣabra-w-wa thabbit aqdāmanā wa-nṣurnā ʿala-l-qawmil-kafirīn.",
      "translation": "Our Lord, pour upon us patience, make our steps firm and grant us victory over the disbelieving people. (2:250)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 34,
      "tags": [
        "Quranic Duas"
      ]
    },
    {
      "id": 35,
      "category_id": 11,
      "title": "Duʿa of Prophet Lut ﷺ for Help Against The Corrupt",
      "title_ar": null,
      "arabic": "رَبِّ انْصُرْنِيْ عَلَى الْقَوْمِ الْمُفْسِدِيْنَ.",
      "transliteration": "Rabbin-ṣurnī ʿala-l-qawmi-l-mufsidīn.",
      "translation": "My Lord, support me against the people who spread corruption. (29:30)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 35,
      "tags": [
        "Quranic Duas",
        "Prophet"
      ]
    },
    {
      "id": 36,
      "category_id": 11,
      "title": "Duʿa for Protection From Being With The Oppressors",
      "title_ar": null,
      "arabic": "رَبَّنَا لَا تَجْعَلْنَا مَعَ الْقَوْمِ الظَّالِمِيْنَ.",
      "transliteration": "Rabbanā lā tajʿalnā maʿal qawmi-ẓ-ẓālimīn.",
      "translation": "Our Lord, do not let us join the wrongdoing people. (7:47)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 36,
      "tags": [
        "Quranic Duas",
        "Protection"
      ]
    },
    {
      "id": 37,
      "category_id": 11,
      "title": "Duʿa for Protection From The Oppressors",
      "title_ar": null,
      "arabic": "رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِّلْقَوْمِ الظَّالِمِيْنَ ، وَنَجِّنَا بِرَحْمَتِكَ مِنَ الْقَوْمِ الْكٰـفِرِيْنَ.",
      "transliteration": "Rabbanā lā tajʿalnā fitnata-l-lil-qawmi-ẓ-ẓālimīn. Wa najjinā bi-raḥmatika mina-l-qawmi-l-kafirīn.",
      "translation": "Our Lord, do not make us victims of the oppressors. Save us, through Your mercy, from the disbelieving people. (10:85-6)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 37,
      "tags": [
        "Quranic Duas",
        "Protection"
      ]
    },
    {
      "id": 38,
      "category_id": 11,
      "title": "Duʿa for Protection From Persecution",
      "title_ar": null,
      "arabic": "رَبَّنَا عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ أَنَبْنَا وَإِلَيْكَ الْمَصِيْرُ. رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِّلَّذِيْنَ كَفَرُواْ وَاغْفِرْ لَنَا رَبَّنَا ۖ ، إِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيْمُ.",
      "transliteration": "Rabbanā ʿalayka tawakkalnā wa ilayka anabnā wa ilaykal-maṣīr. Rabbanā lā tajʿalnā fitnatal-lil-ladhīna kafarū wa-ghfir lanā Rabbanā, innaka Antal-ʿAzīzu-l-Ḥakīm.",
      "translation": "Our Lord, in You Alone we trust, and to You Alone we turn, and to You is the ultimate return. Our Lord, do not let us be persecuted by those who disbelieve, and forgive us, our Lord. Indeed You, and only You, are the All-Mighty, the All-Wise. (60:4-5)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 38,
      "tags": [
        "Quranic Duas",
        "Protection"
      ]
    },
    {
      "id": 39,
      "category_id": 11,
      "title": "Duʿa of Prophet Ayyub ﷺ for Times of Distress",
      "title_ar": null,
      "arabic": "\\-رَبِّ- أَنِّيْ مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرّٰحِمِيْن.",
      "transliteration": "(Rabbi) Annī massaniya-ḍ-ḍurru wa Anta Arḥamu-r-raḥimīn.",
      "translation": "(My Lord), indeed adversity has touched me, and you are the Most Merciful of the merciful. (21:83)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 39,
      "tags": [
        "Quranic Duas",
        "Prophet"
      ]
    },
    {
      "id": 40,
      "category_id": 11,
      "title": "Duʿa of Prophet Yusuf ﷺ for A Good Ending",
      "title_ar": null,
      "arabic": "\\-اَللّٰهُمَّ يَا- فَاطِرَ السَّمٰوَاتِ وَالْأَرْضِ ، أَنْتَ وَلِـيِّيْ فِي الدُّنْيَا وَالْآخِرَةِ ، تَوَفَّنِيْ مُسْلِمًا وَّأَلْحِقْنِيْ بِالصَّالِحِيْنَ.",
      "transliteration": "(Allāhumma yā) Fāṭira-s-samāwāti wa-l-arḍi Anta waliy-yi fi-d-dunyā wal-ākhirah, tawaffanī Muslimaw-wa alḥiqnī bi-ṣ-ṣāliḥīn.",
      "translation": "(O Allah), Originator of the heavens and the earth, You are my Protector in this world and in the Hereafter. Make me die a Muslim and join me with the righteous. (12:101)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 40,
      "tags": [
        "Quranic Duas",
        "Prophet"
      ]
    },
    {
      "id": 41,
      "category_id": 11,
      "title": "Duʿa of Prophet Ibrahim ﷺ & Ismaʿil ﷺ for Acceptance of Good Deeds",
      "title_ar": null,
      "arabic": "رَبَّنَا تَقَبَّلْ مِنَّا ، إِنَّكَ أَنْتَ السَّمِيْعُ الْعَلِيْمُ. وَتُبْ عَلَيْنَا ، إِنَّكَ أَنْتَ التَّوَّابُ الرَّحِيْمُ.",
      "transliteration": "Rabbanā taqabbal minnā innaka Anta-s-Samīʿu-l-ʿAlīm. Wa tub ʿalaynā innaka Anta-t-Tawwābu-r-Raḥīm.",
      "translation": "Our Lord, accept from us. Indeed, You – and You alone – are the All-Hearing, the All-Knowing. And accept our repentance. Indeed, You -and You alone – are the Acceptor of repentance, the very Merciful. (2:127-8)",
      "virtue": "",
      "reference": "",
      "repetitions": null,
      "order": 41,
      "tags": [
        "Quranic Duas",
        "Prophet"
      ]
    }
  ]
