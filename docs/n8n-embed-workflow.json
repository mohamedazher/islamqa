{
  "name": "IslamQA Embedding Proxy",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "encode_search",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate request hash\nconst APP_SECRET = 'islamqa_embed_2024'; // Must match frontend\nconst MAX_AGE_MS = 5 * 60 * 1000; // 5 minutes\n\nconst { query, timestamp, hash } = $input.first().json.body;\n\n// Check required fields\nif (!query || !timestamp || !hash) {\n  return [{ json: { valid: false, error: 'Missing required fields' } }];\n}\n\n// Check timestamp is recent\nconst now = Date.now();\nif (Math.abs(now - timestamp) > MAX_AGE_MS) {\n  return [{ json: { valid: false, error: 'Request expired' } }];\n}\n\n// Calculate expected hash\nconst crypto = require('crypto');\nconst payload = `${query}:${timestamp}:${APP_SECRET}`;\nconst expectedHash = crypto.createHash('sha256').update(payload).digest('hex');\n\n// Validate hash\nif (hash !== expectedHash) {\n  return [{ json: { valid: false, error: 'Invalid hash' } }];\n}\n\nreturn [{ json: { valid: true, query } }];"
      },
      "id": "validate-hash",
      "name": "Validate Hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "valid-check",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid",
      "name": "If Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent?key={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: { parts: [{ text: $json.query }] } }) }}",
        "options": {}
      },
      "id": "gemini-api",
      "name": "Call Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ embedding: $json.embedding.values }) }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.error || 'Validation failed' }) }}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Hash",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Hash": {
      "main": [
        [
          {
            "node": "If Valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Valid": {
      "main": [
        [
          {
            "node": "Call Gemini API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Gemini API": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
