      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate token derived from query + timestamp\nconst MAX_AGE_MS = 5 * 60 * 1000; // 5 minutes\n\nconst body = $input.first().json.body;\nconst { query, timestamp, token } = body;\n\n// Check required fields\nif (!query || !timestamp || !token) {\n  throw new Error('Missing required fields: query, timestamp, token');\n}\n\n// Check timestamp is recent\nconst now = Date.now();\nconst age = Math.abs(now - timestamp);\nif (age > MAX_AGE_MS) {\n  throw new Error(`Request expired (age: ${age}ms, max: ${MAX_AGE_MS}ms)`);\n}\n\n// Regenerate token to verify\nconst payload = `${query}|${timestamp}`;\nlet hash = 5381;\nfor (let i = 0; i < payload.length; i++) {\n  const char = payload.charCodeAt(i);\n  hash = ((hash << 5) + hash) ^ char;\n}\nconst expectedToken = Math.abs(hash >>> 0).toString(16).padStart(8, '0');\n\n// Validate token\nif (token !== expectedToken) {\n  throw new Error(`Invalid token (got: ${token}, expected: ${expectedToken})`);\n}\n\nreturn [{ json: { query } }];"
      },
      "id": "validate",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent?key={{ $env.GEMINI_API_KEY }}",
