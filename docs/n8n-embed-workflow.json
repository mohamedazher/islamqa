{
  "name": "IslamQA Embedding Proxy",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "encode_search",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate request timestamp (simple validation)\nconst MAX_AGE_MS = 5 * 60 * 1000; // 5 minutes\n\nconst body = $input.first().json.body;\nconst { query, timestamp } = body;\n\n// Check required fields\nif (!query || !timestamp) {\n  throw new Error('Missing required fields: query, timestamp');\n}\n\n// Check timestamp is recent\nconst now = Date.now();\nconst age = Math.abs(now - timestamp);\nif (age > MAX_AGE_MS) {\n  throw new Error(`Request expired (age: ${age}ms, max: ${MAX_AGE_MS}ms)`);\n}\n\nreturn [{ json: { valid: true, query } }];"
      },
      "id": "validate-request",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent?key={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: { parts: [{ text: $json.query }] } }) }}",
        "options": {}
      },
      "id": "gemini-api",
      "name": "Call Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ embedding: $json.embedding.values }) }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1050, 200]
    },
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Request": {
      "main": [
        [
          {
            "node": "Call Gemini API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Gemini API": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
